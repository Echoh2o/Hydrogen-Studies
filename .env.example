# Database Configuration (Required)
# Use the connection string for your PostgreSQL database (e.g. Neon, local, etc)
DATABASE_URL="postgresql://user:password@host:port/database?sslmode=require"

# Session Security
# Required in production. Generate a secure key using: openssl rand -hex 32
SESSION_SECRET="dev-secret-change-me-before-production"

# CORS Configuration
# Comma-separated list of allowed origins. Required in production.
ALLOWED_ORIGINS="http://localhost:5000,http://localhost:3000"

# Optional Integrations
OPENAI_API_KEY=""
SENDGRID_API_KEY=""
VITE_GA_MEASUREMENT_ID=""

# Admin Configuration
# Comma-separated list of user IDs that should have admin access
ADMIN_USER_IDS=""
