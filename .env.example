# ===========================================
# Hydrogen Studies - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values.
# For Railway: set these as environment variables in the Railway dashboard.

# --- REQUIRED ---

# Database connection string (PostgreSQL)
# Railway provides this automatically if you add a Postgres plugin.
# For Neon: use the connection string from your Neon dashboard.
DATABASE_URL="postgresql://user:password@host:port/database?sslmode=require"

# Session encryption key (REQUIRED in production)
# Generate with: openssl rand -hex 32
SESSION_SECRET=""

# CORS allowed origins (REQUIRED in production)
# Comma-separated list of your frontend domains.
# Example: https://hydrogenstudies.com,https://www.hydrogenstudies.com
ALLOWED_ORIGINS=""

# --- OPTIONAL ---

# Anthropic API key (PRIMARY — used for all AI text generation: enrichment, blog generation, chat, scoring)
ANTHROPIC_API_KEY=""

# xAI API key (PRIMARY — used for Grok image generation)
XAI_API_KEY=""

# OpenAI API key (fallback for DALL-E image generation if XAI_API_KEY not set)
OPENAI_API_KEY=""

# SendGrid API key (for email notifications)
SENDGRID_API_KEY=""

# Google Analytics measurement ID
VITE_GA_MEASUREMENT_ID=""

# Admin user IDs (comma-separated list of user IDs with admin access)
ADMIN_USER_IDS=""

# PubMed E-Utilities API key (optional but recommended for higher rate limits)
# Without a key: 3 requests/sec. With a key: 10 requests/sec.
# Register at: https://www.ncbi.nlm.nih.gov/account/
PUBMED_API_KEY=""

# Cookie domain (set if using a custom domain in production)
# COOKIE_DOMAIN=".hydrogenstudies.com"

# --- ERROR TRACKING (Sentry) ---
# Without SENTRY_DSN, server errors fall back to structured console logs only
# (visible in Railway deploy logs, not in Sentry). GSC/GA4 sync failures are
# reported via Sentry when this is set. Set in the Railway dashboard for prod.
SENTRY_DSN=""
# Client-side (browser) error tracking DSN
VITE_SENTRY_DSN=""

# --- GOOGLE SEARCH CONSOLE & GA4 SYNC (Optional) ---
# OAuth credentials for the GSC + GA4 data syncs. Connect via the admin UI
# (/api/admin/gsc/oauth, /api/admin/ga4/oauth); tokens are encrypted at rest in
# the DB. GA4_CLIENT_ID/SECRET fall back to the GSC values if unset (one OAuth
# app can serve both). Redirect URIs default to the production callback paths.
GSC_CLIENT_ID=""
GSC_CLIENT_SECRET=""
# GSC_REDIRECT_URI=""                       # default: https://hydrogenstudies.com/api/admin/gsc/oauth/callback
# GSC_SITE_URL="sc-domain:hydrogenstudies.com"
GA4_CLIENT_ID=""                            # falls back to GSC_CLIENT_ID if empty
GA4_CLIENT_SECRET=""                        # falls back to GSC_CLIENT_SECRET if empty
GA4_PROPERTY_ID=""
# GA4_REDIRECT_URI=""                       # default: https://hydrogenstudies.com/api/admin/ga4/oauth/callback

# --- SHOPIFY ---

# Shopify App Secret (used to verify App Proxy HMAC signatures)
# Found in your Shopify Partner Dashboard → App → App setup → Client credentials
# If not set, proxy HMAC verification is skipped (useful for local development).
SHOPIFY_APP_SECRET=""

# --- S3-COMPATIBLE STORAGE (Optional but recommended) ---
# Without these, uploaded images are saved to the local filesystem (uploads/)
# which gets wiped on every Railway deploy. Configure these to persist images
# to S3, Cloudflare R2, DigitalOcean Spaces, or any S3-compatible service.

# Bucket name (REQUIRED to enable cloud storage — if empty, falls back to local disk)
S3_BUCKET=""

# Region (default: "auto" — use "auto" for Cloudflare R2)
S3_REGION="auto"

# Custom endpoint for S3-compatible services (leave empty for AWS S3)
# Cloudflare R2: https://<account-id>.r2.cloudflarestorage.com
# DigitalOcean Spaces: https://<region>.digitaloceanspaces.com
S3_ENDPOINT=""

# Access credentials
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Public URL prefix for served files (e.g. CDN or custom domain)
# Examples:
#   Cloudflare R2 custom domain: https://cdn.hydrogenstudies.com
#   AWS S3: https://my-bucket.s3.us-east-1.amazonaws.com
#   DigitalOcean Spaces CDN: https://my-bucket.nyc3.cdn.digitaloceanspaces.com
S3_PUBLIC_URL=""
