{
  "name": "hydrogen-studies-production",
  "version": "1.0.0",
  "type": "module",
  "main": "start-production.js",
  "scripts": {
    "start": "node start-production.js",
    "build": "node simple-build.js",
    "health": "curl -f http://localhost:5000/health || exit 1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "deployment": {
    "environment": "production",
    "port": 5000,
    "features": {
      "session_storage": "postgresql",
      "ai_categorization": "enabled",
      "study_database": "1326_studies"
    }
  }
}